// Feature 6 — Persistent Webhooks
// See docs/feature-6-spec.md §3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String            @id // Supabase auth.users.id (UUID)
  email        String            @unique
  createdAt    DateTime          @default(now())
  cardOrder    String[]          @default([])
  alerts       Alert[]
  webhooks     Webhook[]
  tickers      UserTicker[]
  tickerGroups UserTickerGroup[]
}

model UserTicker {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId])
}

model UserTickerGroup {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int                   @default(0)
  isDefault Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     UserTickerGroupItem[]

  @@unique([userId, name])
  @@index([userId, position])
}

model UserTickerGroupItem {
  id        String          @id @default(uuid())
  groupId   String
  group     UserTickerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  symbol    String
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  @@unique([groupId, symbol])
  @@index([userId])
  @@index([groupId, position])
}

model TickerQuoteCache {
  symbol                  String    @id
  name                    String?
  price                   Float
  previousClose           Float
  change                  Float
  changePercent           Float
  fetchedAt               DateTime
  sourceUrl               String?
  marketSession           String?
  postMarketPrice         Float?
  postMarketChange        Float?
  postMarketChangePercent Float?
  preMarketPrice          Float?
  preMarketChange         Float?
  preMarketChangePercent  Float?
  staleAt                 DateTime
  lastRefreshAttemptAt    DateTime?
  lastRefreshSuccessAt    DateTime?
  lastRefreshError        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([staleAt])
  @@index([lastRefreshAttemptAt])
}

model Alert {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  logic           String // "AND" | "OR"
  enabled         Boolean     @default(true)
  cooldownMinutes Int         @default(5)
  conditions      Condition[]
  createdAt       DateTime    @default(now())
  lastTriggeredAt DateTime?

  @@index([userId, enabled])
}

model Condition {
  id       String @id @default(uuid())
  alertId  String
  alert    Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  metric   String // "fearGreed" | "vix" | "btc" | "spx" | "ticker:AAPL"
  operator String // "<" | ">" | "<=" | ">=" | "=="
  value    Float
}

model Webhook {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // user label, e.g. "My Discord"
  type      String // "discord" | "slack" | "telegram" | "generic"
  url       String?
  botToken  String?
  chatId    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
}
