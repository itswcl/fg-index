[Unit]
Description=Verify and quarantine the current fg-index API release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=180
User=fg-index-release-poller
Group=fg-index-release-poller
UMask=0077
StateDirectory=fg-index-release-poller
StateDirectoryMode=0700
ExecStart=/usr/bin/python3.12 /usr/local/libexec/fg-index-release-poller/poller.py --root /var/lib/fg-index-release-poller
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fg-index-release-poller
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
