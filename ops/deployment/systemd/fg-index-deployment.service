[Unit]
Description=Verify and select the current-main fg-index API release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=10min
ExecStart=/usr/bin/python3.12 /usr/local/libexec/fg-index-deployment/deploy_api_release.py --once
StandardOutput=journal
StandardError=journal
ProtectHome=read-only
ReadWritePaths=/opt/fg-index /var/lib/fg-index-deployment /etc/fg-index-release-poller
PrivateTmp=yes
