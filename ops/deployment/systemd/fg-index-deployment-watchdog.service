[Unit]
Description=Check fg-index API and recover once to an accepted local image
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=10min
ExecStart=/usr/bin/python3.12 /usr/local/libexec/fg-index-deployment/deploy_api_release.py --watchdog
StandardOutput=journal
StandardError=journal
ProtectHome=yes
PrivateTmp=yes
